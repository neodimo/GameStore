{
  "name": "gamestore",
  "version": "0.18.3",
  "description": "A Windows and Linux visual catalog for discovering English-playable retro games.",
  "author": "Omid & Gonzo",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:web": "tsc -b && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "check:media-light": "node scripts/check-media-light.mjs source",
    "check:bundle-size": "node scripts/check-media-light.mjs build",
    "check:package-size": "node scripts/check-media-light.mjs artifacts",
    "test": "vitest run",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@chainsafe/xdelta3-node": "^1.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "basic-ftp": "^6.2.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2-sftp-client": "^11.0.0",
    "vite": "^6.0.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.neodimo.gamestore",
    "productName": "GameStore",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@chainsafe/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "GameStore-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "GameStore-${version}-${arch}.${ext}",
      "category": "Game",
      "maintainer": "Omid & Gonzo",
      "synopsis": "Discover English-playable retro games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "neodimo",
      "repo": "GameStore"
    }
  }
}
